# Copy to .env for local development. Bun loads .env automatically.
PORT=3000
DATABASE_PATH=data/market-jury.sqlite
CLIENT_DIR=dist

# Alpaca market data (free plan). The Floor Runner refuses to run without them.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Model providers for the Traders and the Market Columnist (`bun run models:check` tests them).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
