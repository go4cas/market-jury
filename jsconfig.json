{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["bun"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["server", "db", "core", "market", "agents", "jobs", "scripts", "tests"]
}
